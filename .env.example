# OpenAI
# NÃO coloque uma chave real neste arquivo versionado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# MySQL
# Estes valores são opcionais. Se não forem definidos, o projeto usa os padrões locais abaixo.
DB_URL=jdbc:mysql://localhost:3306/banco_app?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=root

# Docker Compose: escolha duas senhas diferentes antes de iniciar.
FINIA_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
